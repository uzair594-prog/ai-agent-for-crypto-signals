# Required for Prisma / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js v5 — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
APP_URL=http://localhost:3000

# Google OAuth — configure exact callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transactional email for verification and reset links
RESEND_API_KEY=
EMAIL_FROM=

# 32-byte key encoded as base64; generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Optional distributed rate limiter for production
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Public MEXC market data only; never add trading API credentials
MEXC_PUBLIC_API_BASE_URL=https://contract.mexc.com
